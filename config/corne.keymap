#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   Q    │   W    │   E    │   R    │   T    │                    │   Y    │   U    │   I    │   O    │   P    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │   A    │   S    │   D    │   F    │   G    │                    │   H    │   J    │   K    │   L    │   ;    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │   Z    │   X    │   C    │   V    │   B    │                    │   N    │   M    │   ,    │   .    │   /    │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │  GUI   │  LWR   │  SPC   │  │  RET   │  RSE   │  ALT   │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none  &kp Q  &kp W  &kp E     &kp R  &kp T      &kp Y    &kp U  &kp I      &kp O    &kp P     &none
&none  &kp A  &kp S  &kp D     &kp F  &kp G      &kp H    &kp J  &kp K      &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C     &kp V  &kp B      &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                      &kp LGUI  &mo 1  &kp SPACE  &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   1    │   2    │   3    │   4    │   5    │                    │   6    │   7    │   8    │   9    │   0    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ LCTRL  │        │        │        │        │                    │   ←    │   ↓    │   ↑    │   →    │        │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ LSHFT  │        │        │        │        │                    │        │        │        │        │        │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │  GUI   │        │  SPC   │  │  RET   │  ADJ   │  ALT   │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none  &kp N1     &kp N2  &kp N3    &kp N4  &kp N5     &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &none
&none  &kp LCTRL  &trans  &trans    &trans  &trans     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &none
&none  &kp LSHFT  &trans  &trans    &trans  &trans     &trans    &trans    &trans  &trans     &trans  &none
                           &kp LGUI  &trans  &kp SPACE  &kp RET   &mo 3     &kp RALT
            >;
        };

        raise_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   !    │   @    │   #    │   $    │   %    │                    │   ^    │   &    │   *    │   (    │   )    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ LCTRL  │        │        │        │        │                    │   -    │   =    │   [    │   ]    │   \    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ LSHFT  │        │        │        │        │                    │   _    │   +    │   {    │   }    │   |    │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │  GUI   │  ADJ   │  SPC   │  │  RET   │        │  ALT   │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none  &kp EXCL   &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &none
&none  &kp LCTRL  &trans  &trans    &trans    &trans     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &none
&none  &kp LSHFT  &trans  &trans    &trans    &trans     &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &none
                           &kp LGUI  &mo 3     &kp SPACE  &kp RET    &trans     &kp RALT
            >;
        };

        adjust_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   F1   │   F2   │   F3   │   F4   │   F5   │                    │   F6   │   F7   │   F8   │   F9   │  F10   │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │  F11   │  F12   │        │        │        │                    │        │        │        │        │        │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ BT CLR │  BT 0  │  BT 1  │  BT 2  │  BT 3  │                    │        │        │        │        │        │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │        │        │        │  │        │        │        │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none  &kp F1      &kp F2        &kp F3        &kp F4        &kp F5          &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &kp F11     &kp F12       &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans   &none
&none  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &trans  &trans  &trans  &trans  &trans   &none
                                  &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
