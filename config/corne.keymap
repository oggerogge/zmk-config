#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define FN    4
#define MOUSE 5
#define BT    6

/ {
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp BSPC>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp TAB>;
        };
        combo_del {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&kp DEL>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        fn_layer {
            if-layers = <NUM SYM>;
            then-layer = <FN>;
        };
        bt_layer {
            if-layers = <NUM MOUSE>;
            then-layer = <BT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   Q    │   W    │   E    │   R    │   T    │                    │   Y    │   U    │   I    │   O    │   P    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │   A    │   S    │   D    │   F    │   G    │                    │   H    │   J    │   K    │   L    │   ;    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │   Z    │   X    │   C    │   V    │   B    │                    │   N    │   M    │   ,    │   .    │   /    │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │ MOUSE  │  NAV   │  SPC   │  │  RET   │  SYM   │  NUM   │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none    &kp Q     &kp W     &kp E     &kp R     &kp T              &kp Y     &kp U     &kp I     &kp O     &kp P      &none
&none    &kp A     &kp S     &kp D     &kp F     &kp G              &kp H     &kp J     &kp K     &kp L     &kp SEMI   &none
&none    &kp Z     &kp X     &kp C     &kp V     &kp B              &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH   &none
                             &mo MOUSE &mo NAV   &kp SPACE          &kp RET   &mo SYM   &mo NUM
            >;
        };

        nav_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │        │        │ PrvTab │ NxtTab │        │                    │  PgUp  │  Home  │   ↑    │  End   │  Bksp  │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ sk GUI │ sk ALT │ sk SFT │ sk CTL │        │                    │  PgDn  │   ←    │   ↓    │   →    │  Del   │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │  Undo  │  Cut   │  Copy  │ Paste  │  Redo  │                    │  Tab   │ CpsWrd │ Enter  │  Ins   │  Esc   │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │        │        │        │  │        │        │        │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none    &none     &none     &kp LC(LS(TAB)) &kp LC(TAB) &none      &kp PG_UP &kp HOME  &kp UP    &kp END   &kp BSPC   &none
&none    &sk LGUI  &sk LALT  &sk LSHFT &sk LCTRL &none              &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp DEL    &none
&none    &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(Y)         &kp TAB   &caps_word &kp RET  &kp INS   &kp ESC    &none
                             &trans    &trans    &trans             &trans    &trans    &trans
            >;
        };

        sym_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   ^    │   <    │   >    │   -    │   |    │                    │   $    │   {    │   }    │   ?    │   \    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │   !    │   +    │   /    │   =    │   &    │                    │   #    │   (    │   )    │   ;    │   "    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │   ~    │   *    │   [    │   ]    │   %    │                    │   @    │   :    │   `    │   '    │   _    │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │        │        │        │  │        │        │        │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none    &kp CARET &kp LT    &kp GT    &kp MINUS &kp PIPE           &kp DLLR  &kp LBRC  &kp RBRC  &kp QMARK &kp BSLH   &none
&none    &kp EXCL  &kp PLUS  &kp FSLH  &kp EQUAL &kp AMPS           &kp HASH  &kp LPAR  &kp RPAR  &kp SEMI  &kp DQT    &none
&none    &kp TILDE &kp ASTRK &kp LBKT  &kp RBKT  &kp PRCNT          &kp AT    &kp COLON &kp GRAVE &kp SQT   &kp UNDER  &none
                             &trans    &trans    &trans             &trans    &trans    &trans
            >;
        };

        num_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   1    │   2    │   3    │   4    │   5    │                    │   6    │   7    │   8    │   9    │   0    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ sk GUI │ sk ALT │ sk SFT │ sk CTL │        │                    │   .    │   4    │   5    │   6    │   +    │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │        │        │        │        │        │                    │   0    │   1    │   2    │   3    │   -    │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │        │        │        │  │        │        │        │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5             &kp N6    &kp N7    &kp N8    &kp N9    &kp N0     &none
&none    &sk LGUI  &sk LALT  &sk LSHFT &sk LCTRL &none              &kp DOT   &kp N4    &kp N5    &kp N6    &kp PLUS   &none
&none    &none     &none     &none     &none     &none              &kp N0    &kp N1    &kp N2    &kp N3    &kp MINUS  &none
                             &trans    &trans    &trans             &trans    &trans    &trans
            >;
        };

        fn_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │   F1   │   F2   │   F3   │   F4   │   F5   │                    │   F6   │   F7   │   F8   │   F9   │  F10   │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ sk GUI │ sk ALT │ sk SFT │ sk CTL │        │                    │  F11   │  F12   │ PrtSc  │        │        │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │        │  Play  │  Prev  │  Next  │        │                    │  Mute  │ VolDn  │ VolUp  │ BriDn  │ BriUp  │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │        │        │        │  │        │        │        │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5             &kp F6    &kp F7    &kp F8    &kp F9    &kp F10    &none
&none    &sk LGUI  &sk LALT  &sk LSHFT &sk LCTRL &none              &kp F11   &kp F12   &kp PSCRN &none     &none      &none
&none    &none     &kp C_PP  &kp C_PREV &kp C_NEXT &none            &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &none
                             &trans    &trans    &trans             &trans    &trans    &trans
            >;
        };

        mouse_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │        │        │        │        │        │                    │ WhlUp  │ WhlLft │  MUp   │ WhlRt  │        │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ sk GUI │ sk ALT │ sk SFT │ sk CTL │        │                    │ WhlDn  │  MLft  │  MDn   │  MRt   │        │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │        │        │        │        │        │                    │        │  LClk  │  MClk  │  RClk  │        │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │        │        │        │  │        │        │        │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none    &none     &none     &none     &none     &none              &msc SCRL_UP &msc SCRL_LEFT &mmv MOVE_UP &msc SCRL_RIGHT &none &none
&none    &sk LGUI  &sk LALT  &sk LSHFT &sk LCTRL &none              &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
&none    &none     &none     &none     &none     &none              &none     &mkp LCLK &mkp MCLK &mkp RCLK &none      &none
                             &trans    &trans    &trans             &trans    &trans    &trans
            >;
        };

        bt_layer {
// ┌────────┬────────┬────────┬────────┬────────┐                    ┌────────┬────────┬────────┬────────┬────────┐
// │ BT CLR │  BT 0  │  BT 1  │  BT 2  │  BT 3  │                    │        │        │        │        │        │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │        │        │        │        │  BT 4  │                    │        │        │        │        │        │
// ├────────┼────────┼────────┼────────┼────────┤                    ├────────┼────────┼────────┼────────┼────────┤
// │ bootld │        │        │        │  reset │                    │  reset │        │        │        │ bootld │
// └────────┴────────┴────────┼────────┼────────┼────────┐  ┌────────┼────────┼────────┼────────┴────────┴────────┘
//                            │        │        │        │  │        │        │        │
//                            └────────┴────────┴────────┘  └────────┴────────┴────────┘
            bindings = <
&none    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3  &none  &none     &none     &none     &none      &none
&none    &none     &none     &none     &none     &bt BT_SEL 4              &none  &none     &none     &none     &none      &none
&none    &bootloader &none   &none     &none     &sys_reset                &sys_reset &none &none     &none     &bootloader &none
                             &trans    &trans    &trans                    &trans &trans    &trans
            >;
        };
    };
};
